ACCESS_SECRET="this-is-a-development-environment, DO NOT USE THIS VALUE. INSTEAD, CREATE A COMPLEX SECRET AND KEEP IT SAFE OUTSIDE OF THE SOURCE CODE."
REFRESH_SECRET="this-is-a-development-environment, DO NOT USE THIS VALUE. INSTEAD, CREATE A COMPLEX SECRET AND KEEP IT SAFE OUTSIDE OF THE SOURCE CODE."
EMAIL_VERIFICATION_SECRET="this-is-a-development-environment, DO NOT USE THIS VALUE. INSTEAD, CREATE A COMPLEX SECRET AND KEEP IT SAFE OUTSIDE OF THE SOURCE CODE."
ACCESS_EXPIRES_IN=1h
REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRY_MINUTES=60


