generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------
// ENUMS
// ----------------------

/// Roles for all users in the system
enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

// ----------------------
// MODELS
// ----------------------

/// Application user account (base entity for everyone: admin, attendee, organizer)
model Users {
  id              String @id @default(uuid()) // UUID primary key, globally unique
  firstName       String @map("first_name")
  lastName        String @map("last_name")
  email           String @unique // Login credential + unique constraint
  password        String // Hashed password
  role            Role   @default(ATTENDEE)
  profilePhotoURL String @map("profile_photo_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("Updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  session Session[]
  contact Contact? // Optional 1-1 relation

  @@map("users")
}

model Contact {
  id          String @id @default(uuid())
  userId      String @unique @map("user_id")
  phoneNumber String @unique @map("phone_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("Updated_at")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contact")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  deviceId  String   @unique @map("device_id")
  tokenHash String   @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User (one-to-one), Foreign key with cascadeing delete: deleting a User deletes their Refresh Token

  @@index([expiresAt])
  @@map("session")
}
