generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------
// ENUMS
// ----------------------

/// Roles for all users in the system
enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

// ----------------------
// MODELS
// ----------------------

/// Application user account (base entity for everyone: admin, attendee, organizer)
model Users {
  id                        String    @id@default(uuid()) // UUID primary key, globally unique
  name                      String 
  email                     String    @unique // Login credential + unique constraint
  password                  String  // Hashed password
  role                      Role      @default(ATTENDEE)

  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  isActive                  Boolean   @default(true)

  session Session[] // Optional 1-1 relation

  @@map("users")
}

model Session {
  id                        String    @default(uuid())
  user_id                   String    
  device_id                 String    @unique
  token_hash                String
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  expiresAt                 DateTime

  user                      Users     @relation(fields: [user_id], references: [id], onDelete: Cascade) // Relation to User (one-to-one), Foreign key with cascadeing delete: deleting a User deletes their Refresh Token

  @@index([expiresAt])
  @@map("session")
}
